    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A3D2E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
