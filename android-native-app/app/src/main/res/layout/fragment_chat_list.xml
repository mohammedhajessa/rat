<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/chat_list_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:text="@string/chat_app_name"
            android:textColor="@color/chat_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0"
            android:textDirection="anyRtl" />

        <!-- Encrypted banner — subtle, thin -->
        <TextView
            android:id="@+id/chat_encrypted_banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_encrypted_banner"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/chat_encrypted_banner"
            android:textColor="@color/chat_text_tertiary"
            android:textSize="12sp"
            android:letterSpacing="0"
            android:textDirection="anyRtl"
            android:drawablePadding="6dp"
            app:drawableStartCompat="@drawable/ic_lock_small"
            app:drawableEndCompat="@drawable/ic_lock_small"
            app:drawableTint="@color/chat_text_tertiary" />

        <!-- Filter Tabs — compact pills -->
        <LinearLayout
            android:id="@+id/filter_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="\u0627\u0644\u0643\u0644"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/background_dark"
                android:letterSpacing="0"
                android:background="@drawable/bg_tab_selected" />

            <TextView
                android:id="@+id/tab_favorites"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="\u0627\u0644\u0645\u0641\u0636\u0644\u0629"
                android:textSize="13sp"
                android:textColor="@color/chat_text_tertiary"
                android:letterSpacing="0"
                android:background="@drawable/bg_tab_unselected" />

            <TextView
                android:id="@+id/tab_archived"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="\u0627\u0644\u0645\u0624\u0631\u0634\u0641\u0629"
                android:textSize="13sp"
                android:textColor="@color/chat_text_tertiary"
                android:letterSpacing="0"
                android:background="@drawable/bg_tab_unselected" />
        </LinearLayout>

        <!-- Chat List -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_list_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="100dp" />

            <LinearLayout
                android:id="@+id/chat_list_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/empty_state_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/chat_empty_no_conversations"
                    android:textColor="@color/chat_text_tertiary"
                    android:textSize="16sp"
                    android:letterSpacing="0"
                    android:textDirection="anyRtl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/chat_empty_subtitle"
                    android:textColor="@color/chat_text_tertiary"
                    android:textSize="14sp"
                    android:letterSpacing="0"
                    android:textDirection="anyRtl" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="100dp"
        android:src="@android:drawable/ic_input_add"
        android:tint="@color/white"
        app:backgroundTint="@color/chat_fab_bg"
        app:fabSize="normal"
        android:contentDescription="@string/chat_fab_new_chat" />

</FrameLayout>
