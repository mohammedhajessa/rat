<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <!-- Profile Avatar -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_light"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                android:contentDescription="@string/cd_profile_photo"/>
        </FrameLayout>

        <!-- Search Icon -->
        <ImageView
            android:id="@+id/btn_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_search"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_title"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <!-- Tab Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/all"
                android:textSize="14sp"
                android:textColor="@color/background_dark"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/tab_featured"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_featured"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/tab_top_rated"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_top_rated"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_unselected"/>

            <TextView
                android:id="@+id/tab_most_viewed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_most_viewed"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_unselected"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Books count -->
    <TextView
        android:id="@+id/books_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/books_all"
        android:textSize="14sp"
        android:textColor="@color/text_tertiary"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:indeterminateTint="@color/accent_cyan"
        android:visibility="gone"/>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚"
            android:textSize="48sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/library_empty_title"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/library_empty_subtitle"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"/>

    </LinearLayout>

    <!-- Books RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_books_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_book_library"/>

</LinearLayout>
