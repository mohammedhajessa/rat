<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="16dp"
    android:background="?attr/selectableItemBackground"
    android:padding="4dp">

    <!-- Book Cover with Badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/background_card">

            <ImageView
                android:id="@+id/book_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_book_cover_placeholder"
                android:contentDescription="@string/cd_book_cover"/>

        </androidx.cardview.widget.CardView>

        <!-- Featured Badge -->
        <TextView
            android:id="@+id/book_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip_selected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/featured"
            android:textSize="10sp"
            android:textColor="@color/background_dark"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Book Title -->
    <TextView
        android:id="@+id/book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        tools:text="Sample Book"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.2"/>

    <!-- Book Author -->
    <TextView
        android:id="@+id/book_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Author Name"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
