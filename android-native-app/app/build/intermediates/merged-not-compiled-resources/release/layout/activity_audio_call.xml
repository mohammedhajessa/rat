<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chat_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layoutDirection="rtl">

    <!-- Top spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Avatar -->
    <TextView
        android:id="@+id/call_avatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_avatar_placeholder"
        android:gravity="center"
        android:textColor="?attr/chat_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Name -->
    <TextView
        android:id="@+id/call_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="?attr/chat_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Status: ringing / connected / duration -->
    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/chat_text_secondary"
        android:textSize="16sp" />

    <!-- Mute indicator from other user -->
    <TextView
        android:id="@+id/call_mute_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/call_other_muted"
        android:textColor="?attr/chat_text_tertiary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- Control buttons -->
    <LinearLayout
        android:id="@+id/control_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="48dp">

        <!-- Mute -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginEnd="32dp">

            <ImageView
                android:id="@+id/btn_mute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_mic"
                android:tint="@color/white"
                android:contentDescription="mute" />

            <TextView
                android:id="@+id/label_mute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_mute"
                android:textColor="?attr/chat_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- End call -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_end_call"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:background="@drawable/bg_call_end"
                android:src="@drawable/ic_call_end"
                android:tint="@color/white"
                android:contentDescription="end call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_end"
                android:textColor="?attr/chat_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Speaker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginStart="32dp">

            <ImageView
                android:id="@+id/btn_speaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:background="@drawable/bg_call_button"
                android:src="@drawable/ic_speaker"
                android:tint="@color/white"
                android:contentDescription="speaker" />

            <TextView
                android:id="@+id/label_speaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/call_speaker"
                android:textColor="?attr/chat_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Incoming call buttons (answer/reject) - shown only for incoming -->
    <LinearLayout
        android:id="@+id/incoming_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="48dp"
        android:visibility="gone">

        <!-- Reject -->
        <ImageView
            android:id="@+id/btn_reject"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="16dp"
            android:background="@drawable/bg_call_end"
            android:src="@drawable/ic_call_end"
            android:tint="@color/white"
            android:layout_marginEnd="48dp"
            android:contentDescription="reject" />

        <!-- Answer -->
        <ImageView
            android:id="@+id/btn_answer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="16dp"
            android:background="@drawable/bg_call_answer"
            android:src="@drawable/ic_call"
            android:tint="@color/white"
            android:contentDescription="answer" />
    </LinearLayout>
</LinearLayout>
