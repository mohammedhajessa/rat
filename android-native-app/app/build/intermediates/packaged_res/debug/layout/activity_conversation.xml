<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/chat_background"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="?attr/chat_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="?attr/chat_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="back" />

        <LinearLayout
            android:id="@+id/header_profile_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/contact_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_avatar_placeholder"
                    android:gravity="center"
                    android:textColor="?attr/chat_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/contact_avatar_image"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/contact_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/chat_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/contact_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="متصل"
                        android:textColor="?attr/chat_online"
                        android:textSize="12sp" />

                    <com.h4ckinto.android.ui.views.TypingIndicatorView
                        android:id="@+id/typing_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_call"
            android:tint="?attr/chat_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="call" />

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/chat_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="more" />
    </LinearLayout>

    <!-- Auto-delete banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="?attr/chat_surface">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_lock_small"
            android:contentDescription="lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_auto_delete"
            android:textColor="?attr/chat_text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Encryption footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_lock_small"
            android:contentDescription="encrypted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_e2e_encrypted"
            android:textColor="?attr/chat_text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Modern Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:background="?attr/chat_surface">

        <!-- Send button -->
        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_fab_chat"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:elevation="3dp"
            android:contentDescription="send" />

        <!-- Text input with attach icon inside -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chat_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="46dp">

            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/chat_input_hint"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="?attr/chat_text_primary"
                android:textColorHint="?attr/chat_text_tertiary"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:importantForAutofill="no" />

            <!-- Attach button inside input field -->
            <ImageView
                android:id="@+id/btn_attach"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_attach"
                android:tint="?attr/chat_text_tertiary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="attach" />
        </LinearLayout>

        <!-- Mic button -->
        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="11dp"
            android:src="@drawable/ic_mic"
            android:tint="?attr/chat_text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="mic" />
    </LinearLayout>

    <!-- Modern Recording overlay -->
    <LinearLayout
        android:id="@+id/recording_overlay"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/chat_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <!-- Send voice button -->
        <ImageView
            android:id="@+id/btn_send_recording"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_fab_chat"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:elevation="3dp"
            android:contentDescription="send" />

        <!-- Recording dot -->
        <View
            android:id="@+id/recording_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_recording_dot" />

        <!-- Timer -->
        <TextView
            android:id="@+id/recording_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0:00"
            android:textColor="?attr/chat_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Animated waveform -->
        <com.h4ckinto.android.ui.views.RecordingWaveformView
            android:id="@+id/recording_waveform"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <!-- Cancel button -->
        <ImageView
            android:id="@+id/btn_cancel_recording"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/error"
            android:background="@drawable/bg_cancel_recording"
            android:contentDescription="cancel" />
    </LinearLayout>
</LinearLayout>
