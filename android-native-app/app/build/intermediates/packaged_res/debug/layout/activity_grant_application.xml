<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B4D3E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/logoImageView"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/eagle_logo"
                android:scaleType="centerInside"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طلب منحة"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/descriptionTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يرجى ملء جميع الحقول المطلوبة"
                android:textColor="#AAFFFFFF"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Personal Information Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المعلومات الشخصية"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الاسم الكامل"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/fullNameEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رقم الهوية"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/idNumberEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رقم الهاتف"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/phoneNumberEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="البريد الإلكتروني (اختياري)"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عنوان العقار"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/propertyAddressEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="textPostalAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد أفراد الأسرة"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/familyMembersEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الدخل الشهري"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/monthlyIncomeEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Damage Information Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="معلومات الضرر"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مستوى الضرر"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <Spinner
            android:id="@+id/damageLevelSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_grant_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نوع العقار"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <Spinner
            android:id="@+id/propertyTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_grant_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مساحة العقار (متر مربع)"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/propertyAreaEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نوع الملكية"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <Spinner
            android:id="@+id/propertyOwnershipSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_grant_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تاريخ الضرر (YYYY-MM-DD)"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/damageDateEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="date"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وصف الضرر (اختياري)"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />
        <EditText
            android:id="@+id/damageDescriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:textColor="#FFFFFF"
            android:textColorHint="#60FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/captureLocationButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="التقاط موقع العقار"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_button_green"
            android:layout_marginBottom="12dp"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/capturePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="التقاط صورة للمنزل المتضرر (0/5)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_grant_button_blue"
            android:layout_marginBottom="12dp"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="إرسال الطلب"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_grant_button_submit"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>
