<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:layoutDirection="locale"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="48dp"
                android:paddingBottom="8dp">

                <!-- More Options -->
                <ImageView
                    android:id="@+id/btn_more"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="المزيد"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/book_details"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- Share Button -->
                <ImageView
                    android:id="@+id/btn_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="مشاركة"/>

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="رجوع"/>

            </LinearLayout>

            <!-- Book Cover Large -->
            <androidx.cardview.widget.CardView
                android:layout_width="200dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/background_card">

                <ImageView
                    android:id="@+id/book_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_book_cover_placeholder"
                    android:contentDescription="غلاف الكتاب"/>

            </androidx.cardview.widget.CardView>

            <!-- Book Title -->
            <TextView
                android:id="@+id/book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مكتبة منتصف الليل"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="24dp"/>

            <!-- Book Author -->
            <TextView
                android:id="@+id/book_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="مات هيغ"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:paddingHorizontal="24dp"/>

            <!-- Rating Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/rating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reader_rating"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginEnd="8dp"/>

                <!-- Star Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_star_filled"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star_filled"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star_filled"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star_filled"/>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star_half"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="4.8"
                    android:textSize="14sp"
                    android:textColor="@color/star_filled"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/rating_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="(١٢،٤١ ألف مراجعة)"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"/>

            </LinearLayout>

            <!-- Book Stats Chips -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- Pages -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="٣٠٤"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"/>

                <!-- Language -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="العربية"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"/>

                <!-- Genre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="خيال"
                    android:textSize="14sp"
                    android:textColor="@color/background_dark"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

            <!-- Description Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="24dp"
                android:text="@string/about_book"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/book_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="24dp"
                android:text="بين الحياة والموت توجد مكتبة. وداخل تلك المكتبة، تمتد الأرفف إلى ما لا نهاية. يقدم كل كتاب فرصة لتجربة حياة أخرى كان من الممكن أن تعيشها. لترى كيف ستكون الأمور لو أنك اتخذت خيارات أخرى.\n\nهل كنت ستفعل أي شيء بشكل مختلف، لو أتيحت لك الفرصة للتراجع عن ندمك؟ تخذ نورا سيد نفسها أمام مواجهة هذا القرار. توأجه إمكانية تغيير حياتها بحياة جديدة، واتباع مسار مهني مختلف..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:maxLines="8"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/btn_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="24dp"
                android:text="@string/read_more"
                android:textSize="14sp"
                android:textColor="@color/accent_cyan"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"/>

            <!-- Similar Books Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bestsellers"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_bestsellers"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="للأسف الشائعة"
                        android:textSize="12sp"
                        android:textColor="@color/accent_cyan"
                        android:background="@drawable/bg_chip_selected"/>

                    <TextView
                        android:id="@+id/tab_history"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="تاريخ"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip_unselected"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Similar Books RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/similar_books_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_dark"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="8dp">

        <!-- Bookmark Button -->
        <FrameLayout
            android:id="@+id/btn_bookmark"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_card_rounded">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="إضافة للمفضلة"/>

        </FrameLayout>

        <!-- Start Reading Button -->
        <Button
            android:id="@+id/btn_start_reading"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_accent"
            android:text="@string/start_reading_emoji"
            android:textSize="16sp"
            android:textColor="@color/background_dark"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
